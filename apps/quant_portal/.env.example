# Copy to .env locally, then replace every CHANGE_ME value with a new private value.
# Never commit .env. Production uses DEBUG=0 and compose.prod.yaml with HTTPS.
POSTGRES_DB=quant_portal
POSTGRES_USER=quant_portal
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PRIVATE_PASSWORD
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_50_PLUS_CHARACTER_DJANGO_SECRET
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080
DEBUG=0
APP_HTTP_PORT=8080
PORTAL_IMAGE=quant-portal-app:local
# Set to a DNS name only after a domain points to the server.
SITE_DOMAIN=portal.example.invalid
# Public market output remains disabled in all provided compose files.
PUBLIC_MARKET_DATA_ENABLED=0
