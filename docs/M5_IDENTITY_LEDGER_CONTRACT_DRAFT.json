      "fields": [
        "issue_ref_private",
        "evidence_record_refs",
        "raw_type_class_market_refs",
        "interpreted_type_or_null",
        "listing_mic_or_null",
        "primary_flag_or_null",
        "attribute_date_semantics",
        "interpretation_evidence_ref",
        "exception_codes"
      ]
    },
    "identity_exception": {
      "unit": "one code applied to one source record/relation/attribute",
      "fields": [
        "exception_id",
        "exception_code",
        "subject_kind",
        "subject_ref_private",
        "evidence_refs_private",
        "blocking_dependency",
        "resolution_state"
      ]
    }
  },
  "candidate_relation_statuses": [
    "UNREVIEWED_SOURCE_RECORD",
