{
  "schema_id": "m5_identity_candidate_ledger_contract_draft_v1",
  "contract_status": "DRAFT_ENGINEERING_NOT_A_VENDOR_SCHEMA_NOT_RESEARCHER_APPROVAL",
  "candidate_protocol_sha256": "f1fa28949353adea6aa179854441b48658415ef577a006fe76bd01c779ddaa38",
  "purpose": "Preserve source-bound identity candidates and temporal/eligibility uncertainty; no cohort admission.",
  "reference_asof_date_from_proposal": "2020-01-01",
  "date_policy": {
    "separate_domains": [
      "source observation dates",
      "source asserted valid-time dates",
      "source acquisition timestamp",
      "proposed research reference date"
    ],
    "allowed_date_semantics": [
      "VALID_TIME",
      "OBSERVATION_TIME",
      "ASOF_SNAPSHOT",
      "UNKNOWN"
    ],
    "boundary_states": [
      "KNOWN",
      "UNBOUNDED_WITH_SOURCE_EVIDENCE",
      "UNKNOWN"
    ],
    "end_bound_semantics": [
      "INCLUSIVE",
      "EXCLUSIVE",
      "UNKNOWN"
    ],
    "rules": [
      "A first/last filing observation must not become a validity interval without source-definition evidence.",
      "Blank endpoints do not imply infinity; record a boundary state separately.",
      "Only documented interval endpoints may support a containment result.",
      "Keep original dates and boundary semantics. Any derived half-open form requires an explicit, versioned conversion rule.",
      "A later observation or current Header field must not be backfilled into a historical gap."
    ]
  },
  "logical_tables_not_vendor_column_names": {
    "source_manifest": {
      "unit": "one source file/version",
      "fields": [
        "source_id",
        "logical_role",
        "source_file_sha256",
        "source_bytes",
        "prior_receipt_id",
        "source_scope",
        "dictionary_evidence_ref",
        "column_mapping_sha256",
        "private_path"
      ]
    },
    "source_record": {
      "unit": "one retained upstream logical record",
      "fields": [
        "source_record_id",
        "source_id",
        "private_source_row_locator",
        "raw_record_ref",
        "parse_status",
        "exception_codes"
      ]
    },
    "identity_candidate": {
      "unit": "one explicitly supported candidate relation or candidate path; not an accepted identity",
      "fields": [
        "candidate_id",
        "evidence_record_refs",
        "raw_identifier_refs",
        "normalized_identifiers_or_null",
        "relation_kind",
        "normalization_rule_ref",
        "date_semantics",
        "raw_date_refs",
        "valid_from_or_null",
        "valid_to_or_null",
