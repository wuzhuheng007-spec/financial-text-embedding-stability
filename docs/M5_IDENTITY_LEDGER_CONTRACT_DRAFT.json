  },
  "privacy": {
    "private_only": [
      "raw/normalized real identifiers",
      "CIK-to-issue pairs",
      "source record locators",
      "per-row hashes",
      "private paths",
      "raw records",
      "unredacted SQL or lists"
    ],
    "safe_export": [
      "schema and mapping field names without private values",
      "source roles/file-level hashes",
      "aggregate counts with declared unit",
      "overlap-aware exception counts",
      "explicit unknowns and limitations",
      "actual validation statuses"
    ],
    "no_research_results_from_ledger_counts": true
  },
  "summary_requirements": [
    "Report source records, candidate relations and exceptions as different units.",
    "Exception-code counts may overlap; report distinct affected-subject count separately.",
    "Observed uniqueness in imported sources is not provider-wide uniqueness, historical primary status or final eligibility.",
    "No-match and missing/unparsed source are distinct; do not turn missing source into zero matches.",
    "No formal cohort or financial sample count is inferred from imported source rows or upload identifiers."
  ]
