# HTTPS terminates here; Django trusts X-Forwarded-Proto only because this is
# the sole path to the web container (web publishes no host port).
# Production: SITE_DOMAIN is a real DNS name and Caddy obtains a public
# certificate. Isolated test: SITE_DOMAIN=localhost and CADDY_TLS="tls internal"
# use Caddy's local CA, which is NOT publicly trusted.
{$SITE_DOMAIN} {
	{$CADDY_TLS}
	encode zstd gzip
	reverse_proxy web:8000
}
