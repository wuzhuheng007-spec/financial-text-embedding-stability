# Copy outside the repository (e.g. /srv/quant/private.env, mode 0600) and
# replace every CHANGE_ME. Never commit the real file.
COMPOSE_PROJECT_NAME=quant-personal
POSTGRES_DB=quant_portal
POSTGRES_USER=quant_portal
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_PLUS_CHARACTERS
SECRET_KEY=CHANGE_ME_RANDOM_50_PLUS_CHARACTERS
SITE_DOMAIN=CHANGE_ME.example.com
ALLOWED_HOSTS=CHANGE_ME.example.com
CSRF_TRUSTED_ORIGINS=https://CHANGE_ME.example.com
# Secret files: owned by uid 10001, mode 0400, outside the repository.
MOOMOO_TOKEN_KEY_PATH=/srv/quant/secrets/moomoo_token_key
JIN10_MCP_TOKEN_PATH=/srv/quant/secrets/jin10_mcp_token
MODEL_VOLUME=quant_model_cache_v41
RESEARCH_THREADS=2
# Images: web/migrate/daily-price run APP_IMAGE; the feed (FEED_IMAGE) and the news collector (NEWS_IMAGE) are
# released on their own.
APP_IMAGE=quant-personal-app:local
FEED_IMAGE=quant-personal-app:local
NEWS_IMAGE=quant-personal-app:local
