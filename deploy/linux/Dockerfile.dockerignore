# Allowlist build context for deploy/linux/Dockerfile (BuildKit reads this
# file instead of a root .dockerignore). Everything is excluded first.
**

!apps/quant_portal/manage.py
!apps/quant_portal/requirements.lock
!apps/quant_portal/portal/**
!apps/quant_portal/core/**
!apps/quant_portal/templates/**
!apps/quant_portal/static/**

!scripts/__init__.py
!scripts/jin10_mcp/**
!scripts/jin10_mcp_http.py
!scripts/market_observer_v1/**
!scripts/quant_personal_feed/**
!scripts/quant_cloud_official/**
!scripts/quant_research_v1/**
!scripts/quant_news_v1/**
!scripts/news_sentiment_factor_v41/**
!scripts/news_sentiment_factor_v42/**
!scripts/news_sentiment_factor_v43/**
!scripts/news_sentiment_factor_v44/**
!scripts/news_sentiment_factor_v45/**
# X stance study: only the standard-library read model the portal imports (no collector, no numpy code).
!scripts/x_stance_v1/__init__.py
!scripts/x_stance_v1/config.py
!scripts/x_stance_v1/store.py
!scripts/x_stance_v1/portal_read.py

!configs/*.json

# Frozen phase5 study (program, config, protocol, public summaries, validation record; never ledgers or data).
!research/market_sentiment/phase5_strategy_v1/run.py
!research/market_sentiment/phase5_strategy_v1/check.py
!research/market_sentiment/phase5_strategy_v1/config.json
!research/market_sentiment/phase5_strategy_v1/PROTOCOL_zh.md
!research/market_sentiment/phase5_strategy_v1/environment.json
!research/market_sentiment/phase5_strategy_v1/requirements.txt
!research/market_sentiment/phase5_strategy_v1/AUDIT_FINAL.json
!research/market_sentiment/phase5_strategy_v1/results/*.csv
!research/market_sentiment/phase5_strategy_v1/results/*.json
!research/market_sentiment/phase5_strategy_v1/claude_validation_record/*

# X stance study parameters (no posts, no keys).
!research/x_stance_v1/config/*.json

# Git-tracked redacted receipts that runtime code verifies or displays.
!results/watchlist_live_20261115/*_redacted.json
!results/quant_portal_personal_v16_20261116/security_profiles_redacted.json
!results/market_observer_financial_text_v2_20261115/fact_cards_v4_redacted.json
!results/news_sentiment_factor_v41_20261117/*_redacted.json
!results/news_sentiment_factor_v42_20261117/*_redacted.json
!results/news_sentiment_factor_v43_20261117/*_redacted.json
!results/news_sentiment_factor_v44_20261117/*_redacted.json
!results/news_sentiment_factor_v45_20261117/*_redacted.json

!deploy/linux/entrypoint.py
!deploy/linux/supervisor.py
!deploy/linux/requirements-worker.txt
!deploy/linux/requirements-research.txt

# Re-exclude anything private or generated inside allowed trees.
**/__pycache__
**/*.py[cod]
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.log
**/*private*
**/*.dpapi
**/*.sealed
**/*.pem
**/*.key
**/.env
**/.env.*
apps/quant_portal/var
apps/quant_portal/backups
apps/quant_portal/staticfiles
