[Unit]
Description=X stance daily batch at 13:30 Asia/Shanghai (explicit zone), after the New York calendar date has ended

[Timer]
# The zone is written out: the schedule does not depend on the host's local time zone setting.
# Check on the host with: systemd-analyze calendar "*-*-* 13:30:00 Asia/Shanghai"
OnCalendar=*-*-* 13:30:00 Asia/Shanghai
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
