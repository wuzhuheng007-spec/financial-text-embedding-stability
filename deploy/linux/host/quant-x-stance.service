[Unit]
Description=X stance study: collect (within the shared ledger), classify locally, build derived tables
Requires=docker.service
After=docker.service
StartLimitIntervalSec=1d
StartLimitBurst=2

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/quant-x-stance.sh pipeline
TimeoutStartSec=4h
# 2 = gate closed (no key or no current preflight receipt), 75 = data lock busy: reported, never retried in a loop
SuccessExitStatus=2 75
Nice=10
CPUWeight=20
IOWeight=20
