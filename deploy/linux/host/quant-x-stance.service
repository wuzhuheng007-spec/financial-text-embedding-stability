[Unit]
Description=X stance study: daily planned sample (recent + historical queue) within the shared spending ledger
Requires=docker.service
After=docker.service
StartLimitIntervalSec=1d
StartLimitBurst=2

[Service]
Type=oneshot
EnvironmentFile=/srv/quant/secrets/x_stance.env
ExecStart=/usr/local/sbin/quant-x-stance.sh daily
TimeoutStartSec=90min
# 2 = gate closed (no key or no preflight), 75 = data lock busy: reported, never retried in a loop
SuccessExitStatus=2 75
Nice=10
