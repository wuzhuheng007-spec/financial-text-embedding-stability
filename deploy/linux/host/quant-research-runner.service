[Unit]
Description=Run one queued quant research job (if any) in a bounded one-off container
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/quant-research-runner.sh
# Legacy job <= 300 s plus one protected numeric job <= 900 s (+ claim/finalize); outer bound for the whole service.
TimeoutStartSec=25min
Nice=15
IOSchedulingClass=idle
