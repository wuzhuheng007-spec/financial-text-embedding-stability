{
  "schema": "quant_cloud_official_sources_v1",
  "owner_username": "owner@local.invalid",
  "portal_db": "apps/quant_portal/var/dev.sqlite3",
  "owner_resolver": "sqlite_portal_db",
  "database": "apps/quant_portal/var/official_filings.sqlite3",
  "source": "SEC_EDGAR",
  "endpoints": {
    "ticker_exchange_index": "https://www.sec.gov/files/company_tickers_exchange.json",
    "fund_ticker_index": "https://www.sec.gov/files/company_tickers_mf.json",
    "submissions": "https://data.sec.gov/submissions/CIK{cik10}.json",
    "filing_index": "https://www.sec.gov/Archives/edgar/data/{cik}/{accession_nodash}/",
    "primary_document": "https://www.sec.gov/Archives/edgar/data/{cik}/{accession_nodash}/{primary_document}"
  },
  "window_days": 30,
  "keep_latest_periodic_outside_window": true,
  "periodic_forms": [
    "10-K",
    "10-Q",
    "20-F",
    "N-CSR",
    "N-CSRS",
    "N-30D"
  ],
  "forms": {
    "operating": [
      "8-K",
      "8-K/A",
      "10-K",
      "10-K/A",
      "10-Q",
      "10-Q/A",
      "6-K",
      "20-F",
      "DEF 14A",
      "S-3",
      "S-3ASR",
      "S-8",
      "SC 13D",
      "SC 13D/A",
      "SC 13G",
      "SC 13G/A"
    ],
    "fund": [
      "8-K",
      "10-K",
      "10-Q",
      "N-CSR",
      "N-CSRS",
      "N-30D"
    ]
  },
  "request": {
    "timeout_seconds": 20,
    "min_interval_seconds": 0.25,
    "max_attempts": 3,
    "backoff_seconds": [
      5,
      20
    ],
    "max_response_bytes": 33554432,
    "stop_on_http": [
      401,
      403
    ]
  },
  "_comment": "Official SEC EDGAR metadata only (no filing bodies stored). SEC_USER_AGENT with a contact address comes from the private environment, never from this file.",
  "_comment_fund_forms": "NPORT-P excluded: multi-series trusts (iShares, ProShares) file one per fund, so a trust-level NPORT-P cannot be attributed to the watched ETF.",
  "periodic_max_age_days": 400,
  "_comment_periodic": "Supplementary context only: the latest periodic report per form filed before the window, and only if filed within periodic_max_age_days (a 2004 N-CSR is not a current report). N-30D is the semiannual report of unit investment trusts such as SPY."
}
